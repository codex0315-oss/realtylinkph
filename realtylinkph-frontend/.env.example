# Where the Laravel API lives. Must include the /api suffix.
NUXT_PUBLIC_API_BASE=http://127.0.0.1:8000/api

# Where this Nuxt app lives.
NUXT_PUBLIC_APP_URL=http://localhost:3000

# Geoapify key for the map + geocoding (geoapify.com). Same key as the backend.
NUXT_PUBLIC_GEOAPIFY_KEY=

# Reverb websocket — these three MUST match the backend's REVERB_HOST / PORT /
# REVERB_APP_KEY, or real-time messaging and notifications silently stop working.
# This is the local-development path.
NUXT_PUBLIC_REVERB_HOST=127.0.0.1
NUXT_PUBLIC_REVERB_PORT=8080
NUXT_PUBLIC_REVERB_KEY=

# Hosted Pusher, used in production instead of Reverb. Setting BOTH of these
# switches the websocket transport over; leave them blank locally. They must
# match the backend's PUSHER_APP_KEY / PUSHER_APP_CLUSTER.
NUXT_PUBLIC_PUSHER_KEY=
NUXT_PUBLIC_PUSHER_CLUSTER=

# Only for local development: where the /storage proxy points. The proxy exists
# so the WebGL 360 viewer gets a same-origin texture. Leave unset in production
# when uploads are on S3/R2 — configure CORS on the bucket instead.
NUXT_STORAGE_PROXY=http://127.0.0.1:8000
