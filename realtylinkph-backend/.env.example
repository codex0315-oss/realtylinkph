APP_NAME=RealtyLinkPH
APP_ENV=local
# Generate with: php artisan key:generate
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── Database (PostgreSQL) ───────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=realtylinkph
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database

# ─── File uploads ────────────────────────────────────────────────────────────
# Local disk for development.
#
# IN PRODUCTION THIS MUST BE `s3`. Hosts like Render have an EPHEMERAL
# filesystem — it is wiped on every deploy, restart and sleep/wake — so listing
# photos and agent documents written to local disk WILL disappear.
# Works with AWS S3 or Cloudflare R2 (R2 has a generous free tier).
FILESYSTEM_DISK=local
UPLOAD_DISK=local

# Only needed when UPLOAD_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
# R2: https://<account-id>.r2.cloudflarestorage.com   S3: leave blank
AWS_ENDPOINT=
# Public base URL for the bucket, e.g. https://pub-xxxx.r2.dev
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=true

# Queue MUST be a real driver (not "sync"): emails and the RealtyLink AI
# auto-reply run as queued jobs. Run `php artisan queue:listen` alongside serve.
QUEUE_CONNECTION=database

# ─── Realtime ────────────────────────────────────────────────────────────────
# Two interchangeable backends. Reverb speaks the Pusher protocol, so the
# application code is identical either way — only this configuration changes.
#
# Local development: self-hosted Reverb (`php artisan reverb:start`).
BROADCAST_CONNECTION=reverb
# Any random strings — they just have to match between backend and frontend.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

# Production: hosted Pusher (pusher.com free tier), which avoids running a
# websocket server that sleeps when idle. To use it set
# BROADCAST_CONNECTION=pusher and fill these in from the Pusher app's
# "App Keys" tab. PUSHER_APP_KEY and PUSHER_APP_CLUSTER must match the
# frontend's NUXT_PUBLIC_PUSHER_KEY / NUXT_PUBLIC_PUSHER_CLUSTER.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_SCHEME=https
PUSHER_PORT=443

# ─── Mail (Brevo SMTP) ───────────────────────────────────────────────────────
# Optional for local dev — set MAIL_MAILER=log to write emails to the log file
# instead of sending them.
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── Google (social sign-in + Calendar sync) ─────────────────────────────────
# From console.cloud.google.com. Both redirect URIs must be whitelisted there.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/google/callback
GOOGLE_LOGIN_REDIRECT_URI=http://localhost:3000/auth/google/callback

# ─── AI ──────────────────────────────────────────────────────────────────────
# Groq is tried first for chat auto-replies; Gemini is the fallback and powers
# description generation, the buyer/agent assistants and application review.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ─── Maps / geocoding (geoapify.com) ─────────────────────────────────────────
GEOAPIFY_KEY=

# Where the SPA lives — used in emails and password-reset links.
FRONTEND_URL=http://localhost:3000
