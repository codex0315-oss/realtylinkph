            m4_pSkip[/"Skip file; show name and limit"/]
            m4_dEx{"draftId set?"}
            m4_create["POST /api/properties with current fields (may be blank)"]
            m4_setId["draftId = id; localStorage rl-listing-draft = id"]
            m4_upload["POST /api/properties/{id}/photos multipart; tile shows spinner"]
            m4_upOk{"201 photo?"}
            m4_upFail[/"Remove tile; list failed file"/]
            m4_more{"More photos?"}
            m4_s2["Step 2: Add 360 panoramas (is_360=1), same upload path, or Skip"]
            m4_s3[/"Step 3: offer_type, title, address, type, price, beds, baths, areas, description"/]
            m4_watch["watch(form): dirty=true; debounce 800ms"]
            m4_autosave["PUT /api/properties/{id} with payload()"]
            m4_asOk{"200?"}
            m4_saved[/"Header: Draft saved . time"/]
            m4_asErr[/"Header: Could not save - will retry on next change"/]
