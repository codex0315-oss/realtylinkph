flowchart TD
    subgraph M1["1 - Application Bootstrap, Session and Role Dispatch"]
        subgraph m1_FE["Frontend - Nuxt SPA"]
            m1_start([Start: browser opens realtylinkph.vercel.app])
            m1_load["Load Nuxt app; run client plugins in filename order"]
            m1_p00["Plugin 00.auth: read rl token from localStorage"]
            m1_hasTok{"Token present in localStorage?"}
            m1_pub["Render public site: home rows, /properties, /properties/:id, /agents"]
            m1_wantAuth{"User clicks Sign in or Get started?"}
            m1_gotoAuth["Go to diagram 2: Authentication"]
            m1_setUser["Store user in Pinia authStore"]
            m1_role{"authStore.user.role_type?"}
            m1_dashAdmin["Route /admin: Users, Agents, Listings, Reviews"]
            m1_dashAgent["Route /dashboard: My Listings, Inquiries, Appointments, Calendar, Reviews"]
            m1_dashBuyer["Route /dashboard: Browse, Saved, Messages, Appointments, History"]
            m1_echo["Plugin echo.client: connect Pusher wss with NUXT_PUBLIC_PUSHER_KEY"]
            m1_authz["Custom authorizer: POST /broadcasting/auth with Bearer token at subscribe time"]
            m1_subOk{"Private channel subscription accepted?"}
            m1_rtOn["Realtime ON: listen message.sent, notification, typing whispers"]
            m1_rtOff["Realtime OFF: console warn; pages still work via refresh"]
            m1_hb["Heartbeat: POST /api/heartbeat every 60s"]
            m1_bell["GET /api/notifications -> bell count"]
            m1_act["User performs actions in the current module"]
            m1_evt{"Realtime event received?"}
            m1_apply["Update open screen in place; bump bell count"]
            m1_logout{"User clicks Sign out?"}
            m1_clear["Clear token from localStorage; disconnect Echo; stop heartbeat"]
            m1_fin([End: public site shown])
        end
        subgraph m1_API["API - Laravel 12 on Render"]
            m1_me["GET /api/me  (auth:sanctum)"]
            m1_meValid{"Bearer token found in personal_access_tokens?"}
            m1_meJson[/"200 UserResource: id, name, role_type, agent_profile, favorites, has_gcal"/]
            m1_me401[/"401 Unauthenticated"/]
            m1_hbApi["POST /api/heartbeat: users.last_seen_at = now"]
            m1_notifApi["GET /api/notifications: unread rows for notifiable_id = user"]
            m1_logoutApi["POST /api/logout: delete current access token"]
            m1_bcast["POST /broadcasting/auth: verify Bearer, sign socket_id + channel"]
        end
        subgraph m1_DB["Database & Storage - Neon Postgres"]
            m1_users[("users")]
            m1_pat[("personal_access_tokens")]
            m1_notifs[("notifications")]
        end
        subgraph m1_EXT["External Services"]
            m1_pusher["Pusher Channels ap1"]
        end
        m1_start --> m1_load --> m1_p00 --> m1_hasTok
        m1_hasTok -->|"No token"| m1_pub
        m1_hasTok -->|"Token found"| m1_me
        m1_me --> m1_meValid
        m1_meValid -->|"Not found or revoked"| m1_me401
        m1_me401 -->|"Catch 401"| m1_clear
        m1_clear -->|"Session cleared"| m1_pub
        m1_meValid -->|"Valid token"| m1_pat
        m1_pat -->|"Load owner"| m1_users
        m1_users -->|"User row"| m1_meJson
        m1_meJson -->|"200 JSON"| m1_setUser
        m1_pub --> m1_wantAuth
        m1_wantAuth -->|"No, keep browsing"| m1_pub
        m1_wantAuth -->|"Yes"| m1_gotoAuth
        m1_gotoAuth -->|"Token issued"| m1_me
        m1_setUser --> m1_role
        m1_role -->|"admin or super_admin"| m1_dashAdmin
        m1_role -->|"agent"| m1_dashAgent
        m1_role -->|"buyer or ghost_buyer"| m1_dashBuyer
        m1_dashAdmin --> m1_echo
        m1_dashAgent --> m1_echo
        m1_dashBuyer --> m1_echo
        m1_echo -->|"wss connect"| m1_pusher
        m1_pusher -->|"subscribe private-user.{id}"| m1_authz
        m1_authz -->|"socket_id, channel_name, Bearer"| m1_bcast
        m1_bcast -->|"Signed auth or 403"| m1_subOk
        m1_subOk -->|"200 signed"| m1_rtOn
        m1_subOk -->|"403 or network error"| m1_rtOff
        m1_rtOn --> m1_hb
        m1_rtOff --> m1_hb
        m1_hb -->|"every 60s"| m1_hbApi
        m1_hbApi -->|"UPDATE last_seen_at"| m1_users
        m1_hb --> m1_bell
        m1_bell --> m1_notifApi
        m1_notifApi -->|"SELECT unread"| m1_notifs
        m1_notifs -->|"rows"| m1_bell
        m1_bell --> m1_act
        m1_act --> m1_evt
        m1_evt -->|"message.sent / notification / typing"| m1_apply
        m1_apply --> m1_act
        m1_evt -->|"No event"| m1_logout
        m1_logout -->|"No"| m1_act
        m1_logout -->|"Yes"| m1_logoutApi
        m1_logoutApi -->|"DELETE token row"| m1_pat
        m1_logoutApi -->|"204"| m1_clear
        m1_clear --> m1_fin
    end
    subgraph M2["2 - Authentication"]
        subgraph m2_FE["Frontend - Nuxt SPA"]
            m2_start([Start: Sign in or Get started clicked])
            m2_has{"Has an account?"}
            m2_regForm[/"Register form: name, email, password"/]
            m2_regSubmit["POST /api/register"]
            m2_loginForm[/"Sign in form: email, password"/]
            m2_loginSubmit["POST /api/login"]
            m2_gBtn["Click Continue with Google"]
            m2_gRedirect["GET /api/auth/google/redirect -> browser goes to Google"]
            m2_gCallbackPage["Page /auth/google/callback receives ?code"]
            m2_gPost["POST /api/auth/google/callback with code"]
            m2_forgot{"Forgot password?"}
            m2_forgotForm[/"Email address"/]
            m2_forgotSubmit["POST /api/forgot-password"]
            m2_resetPage["Page /reset-password?token&email"]
            m2_resetForm[/"New password x2"/]
            m2_resetSubmit["POST /api/reset-password"]
            m2_storeTok["Save token to localStorage; authStore.initFromStorage"]
            m2_toMain["Go to diagram 1: GET /api/me and role dispatch"]
            m2_showErr[/"Show field or message error"/]
            m2_verifyPanel["My Profile -> Email status: enter 6-digit code or Resend"]
            m2_verifyCode["POST /api/email/verify with code"]
            m2_fin([End: signed in])
        end
        subgraph m2_API["API - Laravel"]
            m2_regThr{"Throttle 10/min ok?"}
            m2_regVal{"Validation: name required, email unique, password min 8?"}
            m2_regCreate["Create user: role_type=buyer, password bcrypt"]
            m2_regNotify["Queue VerifyEmail notification (signed URL + 6-digit code)"]
            m2_regTok["Create Sanctum token"]
            m2_loginThr{"Throttle 10/min ok?"}
            m2_loginCheck{"Hash check passes and not is_system?"}
            m2_loginTok["Create Sanctum token"]
            m2_gThr{"Throttle 20/min ok?"}
            m2_gExchange["Exchange code with Google for id_token / profile"]
            m2_gValid{"Google returned email?"}
            m2_gFind{"users.email exists?"}
            m2_gCreate["Create user: role_type=buyer, email_verified_at=now"]
            m2_gTok["Create Sanctum token"]
            m2_fThr{"Throttle 5/min ok?"}
            m2_fExists{"Email registered?"}
            m2_fBroker{"Broker throttle: requested under 60s ago?"}
            m2_fToken["Create password_reset_tokens row (60 min)"]
            m2_fNotify["Queue ResetPasswordLink email with FRONTEND_URL link"]
            m2_rThr{"Throttle 10/min ok?"}
            m2_rValid{"Token matches, not expired, password min 8 and confirmed?"}
            m2_rSave["Update password hash; delete reset token"]
            m2_vLink["GET /api/email/verify/{id}/{hash} (signed middleware)"]
            m2_vSig{"Signature and sha1(email) hash valid?"}
            m2_vMark["Set email_verified_at; fire Verified event; redirect FRONTEND_URL/?verified=1"]
            m2_vCodeThr{"Throttle 6/min ok?"}
            m2_vCodeOk{"Code matches?"}
            m2_e422[/"422 validation errors"/]
            m2_e429[/"429 Too many attempts"/]
            m2_e401[/"401 invalid credentials"/]
            m2_e400[/"400 Google exchange failed"/]
            m2_e403[/"403 Invalid verification link"/]
        end
        subgraph m2_DB["Database"]
            m2_users[("users")]
            m2_pat[("personal_access_tokens")]
            m2_prt[("password_reset_tokens")]
            m2_jobs[("jobs")]
        end
        subgraph m2_Q["Queue Worker (in web container)"]
            m2_mailJob["Send mail via Brevo HTTPS API (MAIL_MAILER=brevo)"]
        end
        subgraph m2_EXT["External Services"]
            m2_google["Google OAuth 2.0"]
            m2_brevo["Brevo transactional email"]
        end
        m2_start --> m2_has
        m2_has -->|"No"| m2_regForm --> m2_regSubmit --> m2_regThr
        m2_regThr -->|"Exceeded"| m2_e429 --> m2_showErr
        m2_regThr -->|"Ok"| m2_regVal
        m2_regVal -->|"Fails"| m2_e422 --> m2_showErr
        m2_showErr -->|"User corrects"| m2_regForm
        m2_regVal -->|"Passes"| m2_regCreate
        m2_regCreate -->|"INSERT users"| m2_users
        m2_regCreate --> m2_regNotify
        m2_regNotify -->|"INSERT job"| m2_jobs
        m2_jobs -->|"Worker picks job"| m2_mailJob
        m2_mailJob -->|"POST /v3/smtp/email"| m2_brevo
        m2_regNotify --> m2_regTok
        m2_regTok -->|"INSERT token"| m2_pat
        m2_regTok -->|"200 token + user"| m2_storeTok
        m2_has -->|"Yes"| m2_loginForm --> m2_forgot
        m2_forgot -->|"No"| m2_loginSubmit --> m2_loginThr
        m2_loginThr -->|"Exceeded"| m2_e429
        m2_loginThr -->|"Ok"| m2_loginCheck
        m2_loginCheck -->|"Fails"| m2_e401 --> m2_showErr
        m2_loginCheck -->|"Passes"| m2_loginTok
        m2_loginTok -->|"INSERT token"| m2_pat
        m2_loginTok -->|"200 token + user"| m2_storeTok
        m2_has -->|"Google"| m2_gBtn --> m2_gRedirect
        m2_gRedirect -->|"Redirect with client_id, redirect_uri"| m2_google
        m2_google -->|"Redirect back with code"| m2_gCallbackPage --> m2_gPost --> m2_gThr
        m2_gThr -->|"Exceeded"| m2_e429
        m2_gThr -->|"Ok"| m2_gExchange
        m2_gExchange -->|"Token request"| m2_google
        m2_google -->|"Profile or error"| m2_gValid
        m2_gValid -->|"Error / no email"| m2_e400 --> m2_showErr
        m2_gValid -->|"Profile ok"| m2_gFind
        m2_gFind -->|"Exists"| m2_gTok
        m2_gFind -->|"Not found"| m2_gCreate
        m2_gCreate -->|"INSERT users"| m2_users
        m2_gCreate --> m2_gTok
        m2_gTok -->|"INSERT token"| m2_pat
        m2_gTok -->|"200 token + user"| m2_storeTok
        m2_forgot -->|"Yes"| m2_forgotForm --> m2_forgotSubmit --> m2_fThr
        m2_fThr -->|"Exceeded"| m2_e429
        m2_fThr -->|"Ok"| m2_fExists
        m2_fExists -->|"Not registered"| m2_e422
        m2_fExists -->|"Registered"| m2_fBroker
        m2_fBroker -->|"Yes"| m2_e429
        m2_fBroker -->|"No"| m2_fToken
        m2_fToken -->|"UPSERT email, token, created_at"| m2_prt
        m2_fToken --> m2_fNotify
        m2_fNotify -->|"INSERT job"| m2_jobs
        m2_fNotify -->|"200 Check your inbox"| m2_resetPage
        m2_resetPage --> m2_resetForm --> m2_resetSubmit --> m2_rThr
        m2_rThr -->|"Exceeded"| m2_e429
        m2_rThr -->|"Ok"| m2_rValid
        m2_rValid -->|"Fails"| m2_e422
        m2_rValid -->|"Passes"| m2_rSave
        m2_rSave -->|"UPDATE users.password"| m2_users
        m2_rSave -->|"DELETE token"| m2_prt
        m2_rSave -->|"200 Password reset"| m2_loginForm
        m2_storeTok --> m2_toMain --> m2_fin
        m2_fin -.->|"Later: user clicks email link"| m2_vLink
        m2_vLink --> m2_vSig
        m2_vSig -->|"Invalid"| m2_e403
        m2_vSig -->|"Valid"| m2_vMark
        m2_vMark -->|"UPDATE email_verified_at"| m2_users
        m2_fin -.->|"Or: user enters code"| m2_verifyPanel --> m2_verifyCode --> m2_vCodeThr
        m2_vCodeThr -->|"Exceeded"| m2_e429
        m2_vCodeThr -->|"Ok"| m2_vCodeOk
        m2_vCodeOk -->|"Wrong"| m2_e422
        m2_vCodeOk -->|"Matches"| m2_vMark
    end
    subgraph M3["3 - Agent Verification"]
        subgraph m3_FE["Frontend - Nuxt SPA"]
            m3_start([Start: buyer opens /dashboard/verify])
            m3_fetchMe["GET /api/me -> agent_profile status"]
            m3_exist{"agent_profile exists?"}
            m3_stat{"agent_profile.status?"}
            m3_showPending[/"Application Submitted - pending admin review"/]
            m3_cool{"reapply_at in the future?"}
            m3_showCool[/"Not approved: reason + countdown to re-apply"/]
            m3_chooseType{"Broker or Salesperson?"}
            m3_stepsB["Steps: Information, License Card, Live Scan, Review"]
            m3_stepsS["Steps: Information, Accreditation, Valid ID, Live Scan, Review"]
            m3_info[/"full_name, mobile, prc_number, supervising_broker"/]
            m3_pick[/"Pick document file"/]
            m3_fCheck{"Type in pdf/jpg/png/webp and size 5MB or less?"}
            m3_fReject[/"Show file name and reason; ask again"/]
            m3_selfie["LiveFaceCapture: webcam capture (Retake allowed)"]
            m3_review["Review step"]
            m3_submit["XMLHttpRequest POST /api/agent/verify multipart; upload.onprogress -> percent"]
            m3_overlay[/"Overlay: Uploading your documents N% -> Saving your application"/]
            m3_done[/"Application Submitted; menu shows Agent Application Pending"/]
            m3_errUp[/"Show 429 cool-down or 422 field error"/]
            m3_fin([End])
        end
        subgraph m3_API["API - Laravel"]
            m3_thr{"Throttle ok?"}
            m3_val{"SubmitVerificationRequest: applicant_type, prc_number, files valid?"}
            m3_cd{"Existing profile in 12h re-apply cool-down?"}
            m3_tx["DB transaction: update users.name/phone; store files; upsert agent_profiles status=pending, ai_comment=null"]
            m3_notifA["NotificationService: applicant in-app"]
            m3_notifAdm["For each admin: in-app + NewAgentApplication email (queued)"]
            m3_dispatch["AssessAgentApplication::dispatch(profile.id)->afterCommit()"]
            m3_resp[/"201 AgentProfileResource (no ai_comment for owner)"/]
            m3_e429[/"429 Your application was recently declined"/]
            m3_e422[/"422 validation errors"/]
            m3_pending["GET /api/admin/agent-applications (admin, polls 5s while ai_pending)"]
            m3_decide["POST /api/admin/agent-applications/{profile}/review"]
            m3_act{"action = approve or reject?"}
            m3_approve["status=approved, reviewed_at=now; users.role_type=agent"]
            m3_reject{"reason present?"}
            m3_rejectDo["status=rejected, admin_note=reason, reviewed_at=now"]
            m3_e422r[/"422 reason required"/]
            m3_nApprove["Notify applicant: in-app + AgentApplicationApproved email"]
            m3_nReject["Notify applicant: in-app + AgentApplicationRejected email with reapply time"]
        end
        subgraph m3_DB["Database & Storage"]
            m3_users[("users")]
            m3_profiles[("agent_profiles")]
            m3_store[("Supabase bucket: agent-faces/, agent-docs/")]
            m3_jobs[("jobs")]
        end
        subgraph m3_Q["Queue Worker & Scheduler"]
            m3_job["Job AssessAgentApplication (timeout 150s, tries 2)"]
            m3_jGuard{"profile.status == pending and ai_assessed_at null?"}
            m3_jRead["Read documents from Uploads::disk(); base64 inline_data"]
            m3_jPrompt["Build prompt: AgentCredentialReference + declared name/number + today's date"]
            m3_jCall["Gemini generateContent (60s/model, 2 models)"]
            m3_jOk{"Text returned?"}
            m3_jWrite["UPDATE ai_comment=text, ai_assessed_at=now"]
            m3_jFail["UPDATE ai_comment='assessment unavailable - review manually', ai_assessed_at=now"]
            m3_purge["Scheduler hourly: agents:purge-rejected-documents after cool-down"]
        end
        subgraph m3_EXT["External Services"]
            m3_gemini["Gemini API"]
            m3_brevo["Brevo email API"]
            m3_prc["PRC License Verification portal (admin opens manually)"]
        end
        m3_start --> m3_fetchMe --> m3_exist
        m3_exist -->|"Yes"| m3_stat
        m3_stat -->|"pending"| m3_showPending --> m3_fin
        m3_stat -->|"rejected"| m3_cool
        m3_cool -->|"Yes"| m3_showCool --> m3_fin
        m3_cool -->|"No"| m3_chooseType
        m3_exist -->|"No"| m3_chooseType
        m3_chooseType -->|"Broker"| m3_stepsB --> m3_info
        m3_chooseType -->|"Salesperson"| m3_stepsS --> m3_info
        m3_info --> m3_pick --> m3_fCheck
        m3_fCheck -->|"Fails"| m3_fReject --> m3_pick
        m3_fCheck -->|"Passes"| m3_selfie --> m3_review --> m3_submit
        m3_submit -->|"progress events"| m3_overlay
        m3_submit -->|"multipart"| m3_thr
        m3_thr -->|"Exceeded"| m3_e429 --> m3_errUp
        m3_thr -->|"Ok"| m3_val
        m3_val -->|"Fails"| m3_e422 --> m3_errUp
        m3_errUp --> m3_review
        m3_val -->|"Passes"| m3_cd
        m3_cd -->|"Yes"| m3_e429
        m3_cd -->|"No"| m3_tx
        m3_tx -->|"PUT files"| m3_store
        m3_tx -->|"UPSERT"| m3_profiles
        m3_tx -->|"UPDATE name, phone"| m3_users
        m3_tx -->|"Committed"| m3_notifA --> m3_notifAdm
        m3_notifAdm -->|"INSERT mail jobs"| m3_jobs
        m3_tx -->|"Committed"| m3_dispatch
        m3_dispatch -->|"INSERT job"| m3_jobs
        m3_dispatch --> m3_resp
        m3_resp -->|"201"| m3_done --> m3_fin
        m3_jobs -->|"Worker picks job"| m3_job --> m3_jGuard
        m3_jGuard -->|"No: already decided or assessed"| m3_fin
        m3_jGuard -->|"Yes"| m3_jRead
        m3_jRead -->|"GET objects"| m3_store
        m3_jRead --> m3_jPrompt --> m3_jCall
        m3_jCall -->|"HTTPS"| m3_gemini
        m3_gemini -->|"Response or timeout"| m3_jOk
        m3_jOk -->|"Text"| m3_jWrite
        m3_jOk -->|"Null after 2 models"| m3_jFail
        m3_jWrite -->|"UPDATE"| m3_profiles
        m3_jFail -->|"UPDATE"| m3_profiles
        m3_profiles -->|"ai_pending false"| m3_pending
        m3_pending -->|"Admin reviews docs, AI note, Verify on PRC"| m3_prc
        m3_pending --> m3_decide --> m3_act
        m3_act -->|"approve"| m3_approve
        m3_approve -->|"UPDATE profiles, users"| m3_profiles
        m3_approve -->|"UPDATE role_type"| m3_users
        m3_approve --> m3_nApprove
        m3_nApprove -->|"INSERT mail job"| m3_jobs
        m3_act -->|"reject"| m3_reject
        m3_reject -->|"Missing"| m3_e422r
        m3_reject -->|"Present"| m3_rejectDo
        m3_rejectDo -->|"UPDATE"| m3_profiles
        m3_rejectDo --> m3_nReject
        m3_nReject -->|"INSERT mail job"| m3_jobs
        m3_jobs -->|"Mail jobs"| m3_brevo
        m3_rejectDo -.->|"After 12h cool-down"| m3_purge
        m3_purge -->|"DELETE objects"| m3_store
        m3_purge -->|"NULL document paths"| m3_profiles
    end
    subgraph M4["4 - Listing Management"]
        subgraph m4_FE["Frontend - Nuxt SPA"]
            m4_start([Start: agent opens /dashboard/listings/new])
            m4_ls{"rl-listing-draft in localStorage or ?draft=id?"}
            m4_resume["GET /api/properties/{id}: hydrate form, gallery, panos; jump to last step"]
            m4_resumeOk{"200 and status == draft?"}
            m4_clearLs["Remove rl-listing-draft key"]
            m4_s1["Step 1: Add photos"]
