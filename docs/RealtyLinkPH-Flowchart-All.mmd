            m4_later{"Later action?"}
            m4_unpub["POST /api/properties/{id}/unpublish"]
            m4_sold["POST /api/properties/{id}/mark-sold"]
            m4_relist["POST /api/properties/{id}/relist"]
            m4_edit["PUT /api/properties/{id} (published: title, price, address required)"]
            m4_del["DELETE /api/properties/{id}"]
            m4_fin([End])
        end
        subgraph m4_API["API - Laravel"]
            m4_storeVal{"StorePropertyRequest: all fields nullable, types/max ok?"}
            m4_normalize["normaliseDraftFields: null title/address -> '', price/beds/baths -> 0, type -> house, offer_type -> sale"]
            m4_insert["INSERT properties status=draft, agent_id=user; return fresh()"]
            m4_geoNeed{"Address present and lat/lng empty?"}
            m4_geoDispatch["GeocodeProperty::dispatch(id)"]
            m4_photoVal{"UploadPhotoRequest: image, max 10240KB? PHP upload_max_filesize 12M"}
            m4_photoStore["Uploads::disk()->put('properties/{id}/...'); INSERT property_photos sort_order, is_360"]
            m4_updVal{"UpdatePropertyRequest: draft -> nullable; published -> title/price/address required"}
            m4_updSave["normalise; UPDATE properties; geocode if address changed"]
            m4_pubCheck{"missingForPublish(): title, price gt 0, address, photos exist?"}
            m4_pubSave["UPDATE status=published, unpublish_reason=null, unpublished_at=null"]
            m4_firstPub{"Was previously unpublished (first publish)?"}
            m4_alertBuyers["Queue NewPropertyAlert to users with property_alerts=true"]
            m4_e422p[/"422 listing: This listing still needs ..."/]
            m4_unpubSave["UPDATE status=draft"]
            m4_soldSave["UPDATE status=sold, sold_at=now"]
