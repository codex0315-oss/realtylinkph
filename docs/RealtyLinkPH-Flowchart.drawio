ml=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="247" width="210" height="62" as="geometry"/></mxCell><mxCell id="6mes_conv" value="POST /properties/{id}/conversations → find or create (unique property + buyer + agent)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="425" y="352" width="150" height="76" as="geometry"/></mxCell><mxCell id="6mes_type" value="Buyer types → &quot;typing&quot; whisper on the private channel (no DB write)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="467" width="210" height="70" as="geometry"/></mxCell><mxCell id="6mes_send" value="POST /conversations/{id}/messages (header X-Socket-Id)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="583" width="210" height="62" as="geometry"/></mxCell><mxCell id="6mes_store" value="messages: body, sender · conversations.last_message_at" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="425" y="691" width="150" height="70" as="geometry"/></mxCell><mxCell id="6mes_bc" value="Broadcast MessageSent to the other party (toOthers) · in-app notification" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fontFamily=Helvetica;fontSize=11;fillColor=#E1D5E7;strokeColor=#9673A6;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="803" width="210" height="70" as="geometry"/></mxCell><mxCell id="6mes_online" value="Agent online? (last_seen_at within the presence window)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="900" width="210" height="100" as="geometry"/></mxCell><mxCell id="6mes_live" value="Agent sees it instantly and replies; read receipts update" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="955" y="915" width="210" height="70" as="geometry"/></mxCell><mxCell id="6mes_mailed" value="Already emailed for this conversation recently? (agent_offline_emailed_at)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="1007" width="210" height="110" as="geometry"/></mxCell><mxCell id="6mes_mail" value="Queue email to agent: &quot;a buyer messaged you while you were away&quot;" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;fontFamily=Helvetica;fontSize=11;fillColor=#D5E8D4;strokeColor=#82B366;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="120" y="1139" width="200" height="70" as="geometry"/></mxCell><mxCell id="6mes_setm" value="Set agent_offline_emailed_at" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="145" y="1251" width="150" height="70" as="geometry"/></mxCell><mxCell id="6mes_j1" value="" style="shape=sumEllipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFFFFF;strokeColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="487" y="1385" width="26" height="26" as="geometry"/></mxCell><mxCell id="6mes_job" value="Queue job: SendAiAutoReply (after commit)" style="shape=process;whiteSpace=wrap;html=1;size=0.08;fontFamily=He