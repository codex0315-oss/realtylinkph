fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="2600" math="0" shadow="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4lis_title" value="&lt;b&gt;Listing Management — Draft wizard, autosave, publish rules, lifecycle&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:11px&quot; color=&quot;#5B6B84&quot;&gt;A draft row exists from the first photo; nothing lives only in the browser. Publish is where completeness is enforced.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="80" y="24" width="1000" height="56" as="geometry"/></mxCell><mxCell id="4lis_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="440" y="143" width="120" height="46" as="geometry"/></mxCell><mxCell id="4lis_open" value="Verified agent opens New Listing" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="247" width="210" height="62" as="geometry"/></mxCell><mxCell id="4lis_ls" value="Unfinished draft remembered (local storage / ?draft=id)?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="340" width="210" height="100" as="geometry"/></mxCell><mxCell id="4lis_resume" value="GET /properties/{id}: load fields + stored photos · jump to last step" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;size=0.12;" vertex="1" parent="1"><mxGeometry x="955" y="355" width="210" height="70" as="geometry"/></mxCell><mxCell id="4lis_j1" value="" style="shape=