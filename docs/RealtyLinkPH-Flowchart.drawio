t;Every rejection or take-down records a reason and notifies the person affected. Bulk delete runs one request per account so the progress bar is real.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=17;fontFamily=Helvetica;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="80" y="24" width="1000" height="56" as="geometry"/></mxCell><mxCell id="7adm_start" value="Start" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="720" y="143" width="120" height="46" as="geometry"/></mxCell><mxCell id="7adm_login" value="Sign in with an admin account (role_type=admin)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="675" y="247" width="210" height="62" as="geometry"/></mxCell><mxCell id="7adm_dash" value="GET /admin/stats: users, buyers, agents, admins, listings, pending applications" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;size=0.12;" vertex="1" parent="1"><mxGeometry x="675" y="355" width="210" height="70" as="geometry"/></mxCell><mxCell id="7adm_task" value="Which task?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="675" y="454" width="210" height="96" as="geometry"/></mxCell><mxCell id="7adm_apps" value="GET /admin/agent-applications (pending; AI note polls every 5 s until ready)" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;size=0.12;" vertex="1" parent="1"><mxGeometry x="115" y="576" width="210" height="76" as="geometry"/></mxCe