lor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="955" y="359" width="210" height="62" as="geometry"/></mxCell><mxCell id="5vie_avail" value="GET availability: all 60-min slots − blocked dates/recurring − pending &amp; confirmed bookings" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;size=0.12;" vertex="1" parent="1"><mxGeometry x="395" y="464" width="210" height="76" as="geometry"/></mxCell><mxCell id="5vie_pick" value="Buyer picks a slot + optional note" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="583" width="210" height="62" as="geometry"/></mxCell><mxCell id="5vie_post" value="POST /properties/{id}/appointments" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="695" width="210" height="62" as="geometry"/></mxCell><mxCell id="5vie_free" value="Insert succeeds? (unique agent_id + datetime WHERE pending/confirmed)" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="788" width="210" height="100" as="geometry"/></mxCell><mxCell id="5vie_taken" value="&quot;Someone just booked that time slot — pick another&quot;" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="955" y="807" width="210" height="62" as="geometry"/></mxCell><mxCell id="5vie_pend" value="appointments: status=pending" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;