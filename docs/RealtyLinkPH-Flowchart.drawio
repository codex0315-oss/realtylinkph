"/></mxCell><mxCell id="p4_resume" value="GET /api/properties/{id}: hydrate form, gallery, panos; jump to last step" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="811" y="572" width="220" height="75" as="geometry"/></mxCell><mxCell id="p4_resumeOk" value="200 and status == draft?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="826" y="815" width="190" height="92" as="geometry"/></mxCell><mxCell id="p4_clearLs" value="Remove rl-listing-draft key" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1555" y="1089" width="220" height="45" as="geometry"/></mxCell><mxCell id="p4_s1" value="Step 1: Add photos" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="437" y="1302" width="220" height="45" as="geometry"/></mxCell><mxCell id="p4_pCheck" value="File size 10MB or less and image/*?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1364" y="1515" width="190" height="92" as="geometry"/></mxCell><mxCell id="p4_pSkip" value="Skip file; show name and limit" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;size=0.12;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1214" y="2588" width="220" height="45" as="geometry"/></mxCell><mxCell id="p4_dEx" value="draftId set?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1431" y="1789" width="190" height="76" as="geometry"/></mxCell><mxCell id="p4_create" value="POST /api/properties with current fields (may be blank)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1484" y="2047" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_setId" value="draftId = id; localStorage rl-listing-draft = id" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1484" y="3368" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_upload" value="POST /api/properties/{id}/photos multipart; tile shows spinner" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1416" y="3596" width="220" height="75" as="geometry"/></mxCell><mxCell id="p4_upOk" value="201 photo?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="204" y="4402" width="190" height="76" as="geometry"/></mxCell><mxCell id="p4_upFail" value="Remove tile; list failed file" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;size=0.12;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1079" y="4418" width="220" height="45" as="geometry"/></mxCell><mxCell id="p4_more" value="More photos?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="367" y="4660" width="190" height="76" as="geometry"/></mxCell><mxCell id="p4_s2" value="Step 2: Add 360 panoramas (is_360=1), same upload path, or Skip" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="352" y="4918" width="220" height="75" as="geometry"/></mxCell><mxCell id="p4_s3" value="Step 3: offer_type, title, address, type, price, beds, baths, areas, description" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;size=0.12;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="352" y="5161" width="220" height="75" as="geometry"/></mxCell><mxCell id="p4_watch" value="watch(form): dirty=true; debounce 800ms" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="200" y="5404" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_autosave" value="PUT /api/properties/{id} with payload()" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1352" y="5646" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_asOk" value="200?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1872" y="6422" width="190" height="76" as="geometry"/></mxCell><mxCell id="p4_saved" value="Header: Draft saved . time" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;size=0.12;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="1857" y="6680" width="220" height="45" as="geometry"/></mxCell><mxCell id="p4_asErr" value="Header: Could not save - will retry on next change" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;size=0.12;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="65" y="6180" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_aiQ" value="Generate with AI?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1872" y="6893" width="190" height="76" as="geometry"/></mxCell><mxCell id="p4_aiCall" value="POST /api/ai/generate-description with details + property_id (or in-memory files)" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1917" y="9493" width="220" height="75" as="geometry"/></mxCell><mxCell id="p4_aiOk" value="200 description?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1341" y="10279" width="190" height="76" as="geometry"/></mxCell><mxCell id="p4_aiFill" value="form.description = text" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="213" y="10550" width="220" height="45" as="geometry"/></mxCell><mxCell id="p4_aiErr" value="Could not generate a description" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;size=0.12;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="469" y="10542" width="220" height="60" as="geometry"/></mxCell><mxCell id="p4_leave" value="onBeforeRouteLeave: draftId or dirty?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1805" y="7151" width="190" height="92" as="geometry"/></mxCell><mxCell id="p4_modal" value="Modal: Save as draft / Keep editing / Discard?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;" vertex="1" parent="1"><mxGeometry x="1730" y="7425" width="190" height="108" as="geometry"/></mxCell><mxCell id="p4_flush" value="flushSave(); leavingOnPurpose=true; router.push(target)" style="rounded=0;whiteSpace=wrap;html=1;