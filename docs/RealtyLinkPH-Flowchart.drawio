ontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="425" y="2035" width="150" height="70" as="geometry"/></mxCell><mxCell id="6mes_back" value="Agent returns and replies; conversation continues" style="rounded=0;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="2151" width="210" height="62" as="geometry"/></mxCell><mxCell id="6mes_del" value="A party deletes the conversation?" style="rhombus;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fillColor=#FFF2CC;strokeColor=#D6B656;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="395" y="2244" width="210" height="100" as="geometry"/></mxCell><mxCell id="6mes_delc" value="Confirm → set buyer_deleted_at or agent_deleted_at (hidden for that side only)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fontFamily=Helvetica;fontSize=11;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="985" y="2256" width="150" height="76" as="geometry"/></mxCell><mxCell id="6mes_end" value="End" style="ellipse;whiteSpace=wrap;html=1;fontFamily=Helvetica;fontSize=11;fontStyle=1;fillColor=#F8CECC;strokeColor=#B85450;fontColor=#1C2A44;" vertex="1" parent="1"><mxGeometry x="440" y="2383" width="120" height="46" as="geometry"/></mxCell><mxCell id="6mes_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1C2A44;endArrow=block;endFill=1;strokeColor=#1C2A44;strokeWidth=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;entryX=0.5;entryY=0;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="6mes_start" target="6mes_open"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="6mes_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Helvetica;fontSize=11;fontColor=#1C2A